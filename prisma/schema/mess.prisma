model Mess {
    id        String   @id @default(uuid()) @db.Uuid
    messName  String
    messCode  String   @unique
    messType  MessType
    managerId String   @unique @db.Uuid
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    manager  User         @relation("MessManager", fields: [managerId], references: [id], onDelete: Restrict)
    members  MessMember[]
    mealRate MealRate?
    expenses Expense[]

    @@map("messes")
}
