model Member {
    id        String   @id @default(uuid()) @db.Uuid
    messId    String   @db.Uuid
    name      String
    email     String?
    phone     String?
    joinedAt  DateTime @default(now())
    updatedAt DateTime @updatedAt

    // A member belongs to one mess
    mess        Mess         @relation(fields: [messId], references: [id], onDelete: Cascade)
    mealRecords MealRecord[]
    deposits    Deposit[]

    // Contact details must be unique within the same mess when provided
    @@unique([messId, email])
    @@unique([messId, phone])
    @@index([messId])
    @@map("members")
}
