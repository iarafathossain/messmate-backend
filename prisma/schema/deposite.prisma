model Deposit {
    id           String   @id @default(uuid()) @db.Uuid
    messMemberId String   @db.Uuid
    amount       Decimal  @db.Decimal(10, 2)
    note         String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    member MessMember @relation(fields: [messMemberId], references: [id], onDelete: Cascade)

    @@map("deposits")
}
