model Deposit {
    id           String   @id @default(uuid()) @db.Uuid
    messMemberId String   @db.Uuid
    amount       Decimal  @db.Decimal(10, 2)
    depositDate  DateTime @db.Date
    note         String?
    createdAt    DateTime @default(now())

    member MessMember @relation(fields: [messMemberId], references: [id], onDelete: Cascade)

    @@index([messMemberId, depositDate])
    @@map("deposits")
}
